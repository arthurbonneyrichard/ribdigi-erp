# Domain-specific Caddyfile for erp.ribdigihouse.com
# Prefer editing ops/vps/Caddyfile (used by docker-compose.prod.yml) to this hostname,
# or copy these site blocks into ops/vps/Caddyfile before deploy.

{
	email REPLACE_ME_LETSENCRYPT_EMAIL@example.com
}

erp.ribdigihouse.com {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}
