# Example env for https://erp.ribdigihouse.com
# Prefer: cp ops/vps/env.production.example .env  then set hostnames below.
# NEVER commit a filled .env.

APP_ENV=production
DEBUG=false
ALLOW_DEVELOPMENT_SEED=false
LOG_LEVEL=INFO
UVICORN_WORKERS=2

JWT_SECRET_KEY=REPLACE_ME_JWT_SECRET_MIN_32_CHARS____________
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKUP_ENCRYPTION_KEY=REPLACE_ME_BACKUP_KEY
TOTP_ENCRYPTION_KEY=REPLACE_ME_TOTP_KEY

POSTGRES_USER=ribdigi
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTGRES_DB=ribdigi_erp
DATABASE_URL=postgresql+asyncpg://ribdigi:REPLACE_ME_DB_PASSWORD@postgres:5432/ribdigi_erp

REDIS_URL=redis://redis:6379/0

RABBITMQ_DEFAULT_USER=ribdigi
RABBITMQ_DEFAULT_PASS=REPLACE_ME_RABBIT_PASSWORD
RABBITMQ_URL=amqp://ribdigi:REPLACE_ME_RABBIT_PASSWORD@rabbitmq:5672/
CELERY_BROKER_URL=amqp://ribdigi:REPLACE_ME_RABBIT_PASSWORD@rabbitmq:5672//
CELERY_ENABLED=true
CELERY_TASK_ALWAYS_EAGER=false

MINIO_ROOT_USER=REPLACE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REPLACE_ME_MINIO_USER
S3_SECRET_KEY=REPLACE_ME_MINIO_PASSWORD
S3_BUCKET=ribdigi-prod
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_BACKEND=s3

PUBLIC_HOST=erp.ribdigihouse.com
CORS_ORIGINS=https://erp.ribdigihouse.com
FRONTEND_URL=https://erp.ribdigihouse.com
NEXT_PUBLIC_API_URL=https://erp.ribdigihouse.com/api/v1
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DOMAINS=erp.ribdigihouse.com
TRUSTED_HOSTS=erp.ribdigihouse.com,localhost,127.0.0.1
WEBAUTHN_RP_ID=erp.ribdigihouse.com
WEBAUTHN_RP_NAME="RIBDIGI ERP"
WEBAUTHN_ORIGIN=https://erp.ribdigihouse.com

LOGIN_2FA_ENABLED=true
TOTP_ENFORCED_ROLES=company_admin,super_admin,platform_owner

EMAIL_ENABLED=false
SMS_ENABLED=false
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUIRE_REDIS=true
METRICS_ENABLED=true
REQUEST_LOG_ENABLED=true

MEDIA_DIR=/data/media
BACKUP_DIR=/data/backups
MEDIA_MAX_LOGO_BYTES=2000000
MEDIA_MAX_ATTACHMENT_BYTES=10000000

TRIAL_DAYS=14
TRIAL_GRACE_DAYS=7
