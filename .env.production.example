# EXAMPLE production env — prefer ops/vps/env.production.example for Docker Compose VPS.
# Copy ops/vps/env.production.example → .env (never commit real secrets).
#
# Historical note: this file was also used for Stage 26 K1 kubectl secret examples.

APP_ENV=production
DEBUG=false
ALLOW_DEVELOPMENT_SEED=false
JWT_SECRET_KEY=REPLACE_ME_MIN_32_CHARS________________
DATABASE_URL=postgresql+asyncpg://ribdigi:REPLACE_ME_DB_PASSWORD@postgres:5432/ribdigi_erp
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://ribdigi:REPLACE_ME_RABBIT_PASSWORD@rabbitmq:5672//
CELERY_ENABLED=true
CORS_ORIGINS=https://erp.example.com
FRONTEND_URL=https://erp.example.com
NEXT_PUBLIC_API_URL=https://erp.example.com/api/v1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUIRE_REDIS=true
METRICS_ENABLED=true
REQUEST_LOG_ENABLED=true
BACKUP_ENCRYPTION_KEY=REPLACE_ME_BACKUP_KEY
TOTP_ENCRYPTION_KEY=REPLACE_ME_TOTP_KEY
LOGIN_2FA_ENABLED=true
TOTP_ENFORCED_ROLES=company_admin,super_admin,platform_owner
EMAIL_ENABLED=false
SMS_ENABLED=false
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
