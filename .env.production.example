# Production environment template (Stage 18 C1)
# Copy to `.env.production` (never commit real secrets). Validated by Stage 5 S1 / Settings.validate_production_security.
#
# Required posture:
# - APP_ENV=production, DEBUG=false
# - JWT_SECRET_KEY ≥ 32 chars, not a known weak default
# - CORS_ORIGINS whitelist (no *)
# - RATE_LIMIT_ENABLED=true; prefer RATE_LIMIT_REQUIRE_REDIS=true + redis backend for multi-instance

APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://ribdigi:CHANGE_ME_DB_PASSWORD@postgres:5432/ribdigi_erp
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://ribdigi:CHANGE_ME_MQ_PASSWORD@rabbitmq:5672/
CELERY_ENABLED=true
CELERY_TASK_ALWAYS_EAGER=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Stage 5 S1 — rate limit posture for multi-instance production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUIRE_REDIS=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# CORS must be an explicit HTTPS origin list (wildcard * rejected in production)
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
TRUSTED_HOSTS=api.example.com,app.example.com

# Stage 5 H5 / Stage 18 L1 monitoring
METRICS_ENABLED=true
REQUEST_LOG_ENABLED=true
LOG_LEVEL=INFO

# Email/SMS off by default; enable only with real provider credentials
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_FROM_EMAIL=
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage / backups
STORAGE_BACKEND=local
BACKUP_DIR=/data/backups
MEDIA_DIR=/data/media
ALLOW_DEVELOPMENT_SEED=false

# WebAuthn — set RP ID / origin to the real production host
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_RP_NAME=RIBDIGI ERP
WEBAUTHN_ORIGIN=https://app.example.com
