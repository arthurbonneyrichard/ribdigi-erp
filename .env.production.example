# EXAMPLE production env keys for ribdigi-secrets (Stage 26 K1).
# Copy to .env.production (never commit real secrets) then:
#   kubectl -n <ns> create secret generic ribdigi-secrets --from-env-file=.env.production

APP_ENV=production
DEBUG=false
JWT_SECRET_KEY=REPLACE_ME_MIN_32_CHARS________________
DATABASE_URL=postgresql+asyncpg://user:pass@managed-pg:5432/ribdigi_erp
REDIS_URL=redis://managed-redis:6379/0
CELERY_BROKER_URL=amqp://user:pass@managed-rabbit:5672//
CELERY_ENABLED=true
CORS_ORIGINS=https://app.example.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUIRE_REDIS=true
METRICS_ENABLED=true
REQUEST_LOG_ENABLED=true
BACKUP_ENCRYPTION_KEY=REPLACE_ME_BACKUP_KEY
TOTP_ENCRYPTION_KEY=REPLACE_ME_TOTP_KEY
FRONTEND_URL=https://app.example.com
# AI — leave disabled unless an approved provider key is in the secret store
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
