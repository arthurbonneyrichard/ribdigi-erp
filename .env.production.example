# Ribdigi ERP — production environment template for Dokploy
#
# Paste this into Dokploy → Compose service → Environment
# (Dokploy writes it as `.env` next to docker-compose.dokploy.yml).
#
# Or locally:
#   cp .env.production.example .env
#   # edit every REPLACE_ME_* value — NEVER commit a filled .env
#
# Target site: https://erp.ribdigihouse.com
# Compose Path in Dokploy: docker-compose.dokploy.yml
#
# Generate secrets:
#   openssl rand -hex 32   # JWT / backup / TOTP
#   openssl rand -hex 16   # DB / Rabbit / MinIO passwords

# =============================================================================
# Runtime (must stay production)
# =============================================================================
APP_ENV=production
DEBUG=false
ALLOW_DEVELOPMENT_SEED=false
LOG_LEVEL=INFO
UVICORN_WORKERS=2
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=2

# =============================================================================
# Secrets (REQUIRED — replace REPLACE_ME_*)
# =============================================================================
JWT_SECRET_KEY=REPLACE_ME_JWT_SECRET_MIN_32_CHARS____________
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKUP_ENCRYPTION_KEY=REPLACE_ME_BACKUP_ENCRYPTION_KEY_______
TOTP_ENCRYPTION_KEY=REPLACE_ME_TOTP_ENCRYPTION_KEY___________

# =============================================================================
# PostgreSQL (compose service DNS: postgres) — REQUIRED
# =============================================================================
POSTGRES_USER=ribdigi
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
POSTGRES_DB=ribdigi_erp
DATABASE_URL=postgresql+asyncpg://ribdigi:REPLACE_ME_DB_PASSWORD@postgres:5432/ribdigi_erp

# =============================================================================
# Redis (compose service DNS: redis)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# RabbitMQ / Celery broker (compose service DNS: rabbitmq) — REQUIRED
# =============================================================================
RABBITMQ_DEFAULT_USER=ribdigi
RABBITMQ_DEFAULT_PASS=REPLACE_ME_RABBIT_PASSWORD
RABBITMQ_URL=amqp://ribdigi:REPLACE_ME_RABBIT_PASSWORD@rabbitmq:5672/
CELERY_BROKER_URL=amqp://ribdigi:REPLACE_ME_RABBIT_PASSWORD@rabbitmq:5672//
CELERY_ENABLED=true
CELERY_TASK_ALWAYS_EAGER=false

# =============================================================================
# MinIO / S3 object storage (compose service DNS: minio) — REQUIRED
# =============================================================================
MINIO_ROOT_USER=REPLACE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=REPLACE_ME_MINIO_USER
S3_SECRET_KEY=REPLACE_ME_MINIO_PASSWORD
S3_BUCKET=ribdigi-prod
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
STORAGE_BACKEND=s3

# =============================================================================
# Public site — https://erp.ribdigihouse.com
# NEXT_PUBLIC_API_URL is baked into the frontend image at build time.
# =============================================================================
PUBLIC_HOST=erp.ribdigihouse.com
CORS_ORIGINS=https://erp.ribdigihouse.com
FRONTEND_URL=https://erp.ribdigihouse.com
NEXT_PUBLIC_API_URL=https://erp.ribdigihouse.com/api/v1
# Include localhost/127.0.0.1 so container healthchecks (Host: 127.0.0.1) succeed.
TRUSTED_HOSTS=erp.ribdigihouse.com,localhost,127.0.0.1
WEBAUTHN_RP_ID=erp.ribdigihouse.com
WEBAUTHN_RP_NAME="RIBDIGI ERP"
WEBAUTHN_ORIGIN=https://erp.ribdigihouse.com

# =============================================================================
# Auth / MFA
# =============================================================================
LOGIN_2FA_ENABLED=true
TOTP_ENFORCED_ROLES=company_admin,super_admin,platform_owner

# =============================================================================
# Integrations — keep OFF until real credentials are configured
# (production Settings validators require SMTP_*/Twilio when enabled)
# =============================================================================
EMAIL_ENABLED=false
SMS_ENABLED=false
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=

# =============================================================================
# Rate limits / observability
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUIRE_REDIS=true
METRICS_ENABLED=true
REQUEST_LOG_ENABLED=true

# =============================================================================
# Paths inside containers (named volumes)
# =============================================================================
MEDIA_DIR=/data/media
BACKUP_DIR=/data/backups
MEDIA_MAX_LOGO_BYTES=2000000
MEDIA_MAX_ATTACHMENT_BYTES=10000000

TRIAL_DAYS=14
TRIAL_GRACE_DAYS=7
