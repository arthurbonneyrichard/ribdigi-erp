# Production environment template (Stage 18 C1)
# Copy to `.env.production` (never commit real secrets). Validated by Stage 5 S1 / Settings.validate_production_security.
#
# Required posture:
# - APP_ENV=production, DEBUG=false
# - JWT_SECRET_KEY ≥ 32 chars, not a known weak default
# - CORS_ORIGINS whitelist (no *)
# - RATE_LIMIT_ENABLED=true; prefer RATE_LIMIT_REQUIRE_REDIS=true + redis backend for multi-instance

APP_ENV=production
DEBUG=false
DATABASE_URL=postgresql+asyncpg://ribdigi:CHANGE_ME_DB_PASSWORD@postgres:5432/ribdigi_erp
# Optional Stage 27 P1 — route app via PgBouncer (keep Alembic on postgres:5432):
# DATABASE_URL=postgresql+asyncpg://USER:PASS@pgbouncer:6432/ribdigi_erp
# PGBOUNCER_TRANSACTION_MODE=true
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://ribdigi:CHANGE_ME_MQ_PASSWORD@rabbitmq:5672/
CELERY_ENABLED=true
CELERY_TASK_ALWAYS_EAGER=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Stage 5 S1 — rate limit posture for multi-instance production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUIRE_REDIS=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# CORS must be an explicit HTTPS origin list (wildcard * rejected in production)
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
TRUSTED_HOSTS=api.example.com,app.example.com

# Stage 5 H5 / Stage 18 L1 monitoring
METRICS_ENABLED=true
# SEC-H2 — require scrape bearer in production (Prometheus Authorization header)
METRICS_REQUIRE_AUTH=true
METRICS_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_16_CHAR_METRICS_TOKEN
REQUEST_LOG_ENABLED=true
LOG_LEVEL=INFO

# SEC-H4 — enable only when Traefik/nginx/Ingress sets X-Forwarded-For from the real client
TRUST_X_FORWARDED_FOR=true

# Email/SMS off by default; enable only with real provider credentials
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_FROM_EMAIL=
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage / backups
STORAGE_BACKEND=local
BACKUP_DIR=/data/backups
# SEC-M4 — dedicated Fernet keys (required in production; JWT+static-salt fallback is fail-closed).
# Generate separately (do not reuse JWT_SECRET_KEY):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_generate_key_OUTPUT________________
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_generate_key_OUTPUT________________
# Stage 27 B1 — set true + bucket to mirror each .ribbak after create_backup
BACKUP_OFFSITE_UPLOAD_ENABLED=false
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_PREFIX=ribdigi/logical/ribbak
MEDIA_DIR=/data/media
ALLOW_DEVELOPMENT_SEED=false
# SEC-M3 — keep false in production (platform/invite onboarding). Set true only for intentional public signup.
ALLOW_PUBLIC_TENANT_SIGNUP=false
# SEC-M2 / SEC-M5 — keep false by default (Bearer dual-mode). Ops enable on
# staging/prod after cookie soak evidence (SEC-M2 FIXED) — see
# docs/ADR_SESSION_COOKIE_DUAL_MODE.md and sec_m2_staging_soak_checklist.
AUTH_HTTPONLY_COOKIES_ENABLED=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=true

# WebAuthn — set RP ID / origin to the real production host
WEBAUTHN_RP_ID=app.example.com
WEBAUTHN_RP_NAME=RIBDIGI ERP
WEBAUTHN_ORIGIN=https://app.example.com

# Offline Web Push for remote wipe (PARTIAL — not Offline Complete / not 7-day VERIFIED).
# Fail-closed posture: leave ENABLED=false OR leave VAPID keys empty until ops generates
# a real keypair. Wipe still soft-locks + queues; push is disabled/skipped_unconfigured
# (never fabricates delivered). See docs/OFFLINE_WEB_PUSH_VAPID_OPS.md.
OFFLINE_PUSH_ENABLED=false
OFFLINE_PUSH_VAPID_PUBLIC_KEY=
OFFLINE_PUSH_VAPID_PRIVATE_KEY=
OFFLINE_PUSH_VAPID_SUBJECT=mailto:ops@example.com
OFFLINE_PUSH_MAX_ATTEMPTS=3
OFFLINE_PUSH_RETRY_DELAY_MS=100
