    "test:offline": "node scripts/test-offline.js"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "22.17.1",
    "@types/react": "19.2.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "5.9.2"
  }
}
