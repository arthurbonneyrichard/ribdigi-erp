APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://ribdigi:ribdigi@postgres:5432/ribdigi_erp
JWT_SECRET_KEY=replace-with-a-strong-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://ribdigi:ribdigi@rabbitmq:5672/
CELERY_ENABLED=true
CELERY_TASK_ALWAYS_EAGER=false
CELERY_LOW_STOCK_INTERVAL_MINUTES=60
CELERY_PAYMENT_DUE_INTERVAL_MINUTES=60
CELERY_RECURRING_INTERVAL_MINUTES=15
CELERY_BACKUP_INTERVAL_MINUTES=60
CELERY_TRIAL_INTERVAL_MINUTES=60
TRIAL_DAYS=14
TRIAL_GRACE_DAYS=7
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ribdigi-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# local (default) | s3 — use s3 with MinIO or AWS; object keys stay tenant-scoped
STORAGE_BACKEND=local
# SEC-M4 — optional in development (JWT-derived Fernet fallback). Required in production
# (see `.env.production.example`). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# Stage 27 B1 — opt-in auto .ribbak upload after create_backup (default off)
BACKUP_OFFSITE_UPLOAD_ENABLED=false
BACKUP_OFFSITE_S3_BUCKET=
BACKUP_OFFSITE_S3_PREFIX=ribdigi/logical/ribbak
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Rate limits (Stage 5 S1). For production multi-instance see `.env.production.example`
# and `docker-compose.prod.yml` (RATE_LIMIT_REQUIRE_REDIS=true, RATE_LIMIT_BACKEND=redis).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_REQUIRE_REDIS=false
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
METRICS_ENABLED=true
REQUEST_LOG_ENABLED=true
LOG_LEVEL=INFO
# SEC-H2 — leave false in local/dev so Prometheus scrapes without a token; enable in production.
METRICS_REQUIRE_AUTH=false
METRICS_BEARER_TOKEN=
# SEC-H4 — set true only behind a trusted reverse proxy that strips/overwrites X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
# Passkeys: RP ID must match the browser host (localhost or your domain); origin must match FRONTEND_URL
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=RIBDIGI ERP
WEBAUTHN_ORIGIN=http://localhost:3000
# Bank feed connectors (per-connection provider mock|http_json; global kill-switch)
BANK_FEED_SYNC_ENABLED=true
BANK_FEED_TIMEOUT_SECONDS=30
CELERY_BANK_FEED_INTERVAL_MINUTES=360
# POS cash drawer fallback when shift has no store (none|mock|network|browser_bridge)
POS_DRAWER_FALLBACK_MODE=mock
POS_DRAWER_DEFAULT_PORT=9100
POS_DRAWER_TIMEOUT_SECONDS=3
ALLOW_DEVELOPMENT_SEED=false
# Opt-in live customer-demo tenant seed (see docs/DEMO_ACCOUNT.md). Keep false unless seeding demos.
ALLOW_DEMO_TENANT_SEED=false
MEDIA_DIR=/data/media
MEDIA_MAX_LOGO_BYTES=2000000
MEDIA_MAX_ATTACHMENT_BYTES=10000000
# SEC-M3 — local/dev convenience; production template leaves this false (fail closed).
ALLOW_PUBLIC_TENANT_SIGNUP=true
# SEC-M2 / SEC-M5 — httpOnly cookie sessions + CSRF dual-mode (default OFF;
# SEC-M2 FIXED via automated soak; set true to exercise cookie auth locally).
AUTH_HTTPONLY_COOKIES_ENABLED=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=  # unset = auto (secure in production)
# AUTH_COOKIE_DOMAIN=
# Offline Web Push for remote wipe (PARTIAL — not Offline Complete).
# Fail-closed: without both VAPID keys, wipe still queues; push is skipped_unconfigured.
# Generate keys: see docs/OFFLINE_WEB_PUSH_VAPID_OPS.md
OFFLINE_PUSH_ENABLED=true
OFFLINE_PUSH_VAPID_PUBLIC_KEY=
OFFLINE_PUSH_VAPID_PRIVATE_KEY=
OFFLINE_PUSH_VAPID_SUBJECT=mailto:noreply@localhost
OFFLINE_PUSH_MAX_ATTEMPTS=3
OFFLINE_PUSH_RETRY_DELAY_MS=50
# ADR-005 membership scope cutover (default OFF). Assignment APIs may exist;
# when true: store_manager = manager_id ∪ memberships; cashiers fail-closed on POS/stores.
# Enabling does not claim Complete. Ops: docs/adr005_staging_soak_checklist.md
# ADR-005 Complete (automated soak). Default OFF = ops cutover — does not reopen Complete.
STORE_MEMBERSHIP_SCOPE_ENABLED=false
# ADR-002 paid billing scaffold (PARTIAL — Complete MISSING). Keys empty = fail-closed
# portal/checkout. Default OFF — trial/grace/suspend remains authoritative. When true,
# provider subscription mirror gates only POST /sales + PATCH /companies/{id}
# (active/trialing allow). Never claim Complete. Ops: docs/PAID_BILLING_PROVIDER_OPS.md
# Operator pack: docs/GO_LIVE_READINESS_CHECKLIST.md
PAID_BILLING_ENTITLEMENT_GATE_ENABLED=false
BILLING_PROVIDER=
BILLING_PROVIDER_SECRET_KEY=
BILLING_PROVIDER_WEBHOOK_SECRET=
BILLING_PROVIDER_PORTAL_RETURN_URL=
BILLING_PROVIDER_CHECKOUT_SUCCESS_URL=
BILLING_PROVIDER_CHECKOUT_CANCEL_URL=
BILLING_PROVIDER_PRICE_IDS=
BILLING_PROVIDER_MODE=
BILLING_CHECKOUT_ENABLED=false
# Production template (Stage 18 C1): `.env.production.example` + `docker-compose.prod.yml`
# (no Kubernetes deploy in CI).
